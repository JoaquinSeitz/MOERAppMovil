@page "/{*url}"
@using MOERAppMovil.Layout

<PageTitle>Página no encontrada</PageTitle>

<LayoutView Layout="@typeof(MainLayout)">
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16 d-flex flex-column align-center">
        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Color="Color.Primary" Style="font-size: 100px;" Class="mb-4" />
        <MudText Typo="Typo.h3" Color="Color.Primary" Class="mb-2">404</MudText>
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-6">
            Lo sentimos, no pudimos encontrar la página que buscas.
        </MudText>
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Style="border-radius: 8px;">
            Volver al Inicio
        </MudButton>
    </MudContainer>
</LayoutView>