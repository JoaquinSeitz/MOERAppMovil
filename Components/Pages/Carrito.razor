@page "/carrito"
@using MOERAppMovil.DTOs
@using MOERAppMovil.Services
@using System.Text.Json
@inject CarritoService CarritoSvc
@inject PedidoService PedidoService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@implements IDisposable
@attribute [Authorize(Roles = "Cliente")]

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-5 pb-16">
    <div class="d-flex align-center mb-6">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary" OnClick="VolverAtras" Class="mr-2" />
        <MudText Typo="Typo.h5" Color="Color.Primary" Style="font-family: 'Georgia', serif;">Mi Carrito</MudText>
    </div>

    @if (!CarritoSvc.Items.Any())
    {
        <MudPaper Padding="Padding.All" Class="pa-6 mb-6 d-flex flex-column align-center" Elevation="0" Style="background-color: transparent;">
            <MudIcon Icon="@Icons.Material.Filled.RemoveShoppingCart" Color="Color.Default" Style="font-size: 80px; opacity: 0.5;" Class="mb-4" />
            <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Default">Tu carrito está vacío</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-6 rounded-pill" Href="/productos">Ir a la Tienda</MudButton>
        </MudPaper>

        @* SECCIÓN DE PEDIDOS RECIENTES *@
        @if (_cargandoPedidos)
        {
            <div class="d-flex justify-center my-4">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (_ultimosPedidos != null && _ultimosPedidos.Any())
        {
            <MudText Typo="Typo.subtitle1" Class="fw-bold mb-3 mt-4" Style="color: var(--mud-palette-primary);">Pedidos Recientes</MudText>
            <MudStack Spacing="3">
                @foreach (var pedido in _ultimosPedidos.Take(3))
                {
                    <MudCard Elevation="1" Style="border-radius: 12px; border-left: 4px solid var(--mud-palette-secondary);">
                        <MudCardContent Class="pa-3">
                            <div class="d-flex justify-space-between align-center mb-1">
                                <MudText Typo="Typo.body2" Class="fw-bold">Pedido #@pedido.IdPedido</MudText>
                                <MudChip T="string" Color="@GetEstadoColor(pedido.Estado)" Size="Size.Small" Class="mt-0">@pedido.Estado</MudChip>
                            </div>
                            <MudText Typo="Typo.caption" Class="text-muted d-block mb-1">@pedido.Fecha.ToString("dd/MM/yyyy")</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Primary" Class="fw-bold">@pedido.Total.ToString("C")</MudText>
                        </MudCardContent>
                    </MudCard>
                }
            </MudStack>
        }
    }
    else
    {
        <MudPaper Elevation="0" Class="pa-0 mb-6" Style="background-color: transparent;">
            @foreach (var item in CarritoSvc.Items)
            {
                <MudCard Elevation="2" Class="mb-4" Style="border-radius: 12px;">
                    <MudCardContent Class="pa-4">
                        <div class="d-flex justify-space-between align-start">
                            <div>
                                <MudText Typo="Typo.subtitle1" Style="font-weight: bold;">@item.Producto.Nombre</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Default" Class="mb-2">@item.Producto.Precio.ToString("C") c/u</MudText>
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" OnClick="@(() => CarritoSvc.EliminarProducto(item.Producto.IdProducto))" />
                        </div>

                        <div class="d-flex justify-space-between align-center mt-2">
                            <div style="width: 120px;">
                                <MudNumericField T="int"
                                                 Value="@item.Cantidad"
                                                 ValueChanged="@((int val) => { CarritoSvc.ActualizarCantidad(item.Producto.IdProducto, val); })"
                                                 Min="1" Max="@item.Producto.StockActual"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 Immediate="false" HideSpinButtons="false" />
                            </div>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight: bold;">@item.Subtotal.ToString("C")</MudText>
                        </div>
                    </MudCardContent>
                </MudCard>
            }
        </MudPaper>

        <MudPaper Elevation="4" Class="pa-4" Style="border-radius: 15px; background-color: var(--mud-palette-surface);">
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h6">Total a Pagar:</MudText>
                <MudText Typo="Typo.h5" Color="Color.Primary" Style="font-weight: bold;">@CarritoSvc.ObtenerTotal().ToString("C")</MudText>
            </div>

            <MudText Typo="Typo.caption" Color="Color.Default" Class="d-block mb-4 text-center">
                - El pago y retiro se realizan en el local.
            </MudText>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true"
                       OnClick="ConfirmarPedido" Disabled="@isSubmitting" Style="border-radius: 8px;">
                @if (isSubmitting)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <span class="ms-2">Procesando...</span>
                }
                else
                {
                    <span>Confirmar Pedido</span>
                }
            </MudButton>
        </MudPaper>
    }
</MudContainer>

@code {
    private bool isSubmitting = false;
    private List<PedidoResponseDTO> _ultimosPedidos;
    private bool _cargandoPedidos = false;

    protected override async Task OnInitializedAsync()
    {
        CarritoSvc.OnChange += StateHasChanged;

        // Si el carrito está vacío al entrar, cargamos el historial
        if (!CarritoSvc.Items.Any())
        {
            await CargarHistorial();
        }
    }

    public void Dispose()
    {
        CarritoSvc.OnChange -= StateHasChanged;
    }

    private async Task CargarHistorial()
    {
        _cargandoPedidos = true;
        try
        {
            // Traemos los pedidos usando el método que ya existía en tu PedidoService
            var todosLosPedidos = await PedidoService.GetMisPedidos();
            // Los ordenamos por fecha descendente
            _ultimosPedidos = todosLosPedidos.OrderByDescending(p => p.Fecha).ToList();
        }
        catch
        {
            // Si falla silenciosamente no pasa nada, simplemente no se muestra el historial
        }
        finally
        {
            _cargandoPedidos = false;
            StateHasChanged();
        }
    }

    private void VolverAtras()
    {
        Navigation.NavigateTo("/productos");
    }

    private async Task ConfirmarPedido()
    {
        isSubmitting = true;
        var dto = CarritoSvc.GenerarDTO();

        try
        {
            var response = await PedidoService.CrearPedido(dto);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("¡Pedido generado con éxito! Retíralo en el local.", Severity.Success);
                CarritoSvc.VaciarCarrito();
                await CargarHistorial(); // Refrescamos el historial para que aparezca el nuevo pedido
            }
            else
            {
                string mensajeError = "Error procesando el pedido.";
                var errorStr = await response.Content.ReadAsStringAsync();

                try
                {
                    var errorResult = JsonSerializer.Deserialize<ErrorResponse>(errorStr, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    if (!string.IsNullOrEmpty(errorResult?.Mensaje)) mensajeError = errorResult.Mensaje;
                }
                catch { }

                Snackbar.Add(mensajeError, Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Falla de conexión al procesar el pedido.", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private Color GetEstadoColor(string estado) => estado switch
    {
        "Pendiente" => Color.Warning,
        "Entregado" => Color.Success,
        "Cancelado" => Color.Error,
        "Listo para retiro" => Color.Info,
        _ => Color.Default
    };

    private class ErrorResponse { public string Mensaje { get; set; } }
}