@page "/login"
@using MOERAppMovil.DTOs
@using MOERAppMovil.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Padding="Padding.All" Class="pa-8" Elevation="4" Style="border-radius: 15px;">
        <div class="d-flex justify-center mb-4">
            <MudIcon Icon="@Icons.Material.Filled.Spa" Color="Color.Primary" Size="Size.Large" />
        </div>
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-6" Style="font-family: 'Georgia', serif; color: #E0926C;">
            Iniciar Sesión
        </MudText>

        <EditForm Model="@loginModel" OnValidSubmit="ProcesarLogin">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="loginModel.Email" Label="Correo Electrónico" For="@(() => loginModel.Email)" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="loginModel.Contrasenia" Label="Contraseña" For="@(() => loginModel.Contrasenia)" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-4" />

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="@_cargando" Style="border-radius: 8px; margin-bottom: 24px;">
                @if (_cargando)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                }
                else
                {
                    <text>Ingresar</text>
                }
            </MudButton>
        </EditForm>

        <MudDivider Class="mb-4" />

        <MudAlert Severity="Severity.Info" Class="mt-2" Dense="true" Icon="@Icons.Material.Filled.DesktopMac">
            Para registrar una cuenta nueva, por favor ingresa a nuestro sitio web desde tu computadora o navegador.
        </MudAlert>

    </MudPaper>
</MudContainer>

@code {
    private LoginDTO loginModel = new();
    private bool _cargando = false;

    private async Task ProcesarLogin()
    {
        _cargando = true;
        var resultado = await AuthService.LoginAsync(loginModel.Email, loginModel.Contrasenia);

        if (resultado.Exito)
        {
            var customAuthStateProvider = (CustomAuthStateProvider)AuthStateProvider;
            customAuthStateProvider.MarcarComoAutenticado("Usuario", "Cliente");

            Snackbar.Add("¡Bienvenido a MOER Estética!", Severity.Success);
            Navigation.NavigateTo("/", forceLoad: true);
        }
        else
        {
            Snackbar.Add(resultado.Mensaje, Severity.Error);
        }
        _cargando = false;
    }
}