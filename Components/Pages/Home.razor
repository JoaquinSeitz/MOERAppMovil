@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="pa-4 pb-16">

    @* --- VISTA EXCLUSIVA PARA EL ADMINISTRADOR --- *@
    <AuthorizeView Roles="Admin">
        <Authorized>
            <MudText Typo="Typo.h5" Class="fw-bold mb-4" Style="color: var(--mud-palette-primary);">Panel de Administración</MudText>

            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-6" Style="border-color: var(--mud-palette-primary);">
                Estás conectado como <b>Administrador</b>. Seleccioná un módulo para gestionar.
            </MudAlert>

            <MudGrid>
                <MudItem xs="6">
                    <MudPaper Class="pa-4 d-flex flex-column align-center justify-center cursor-pointer" Elevation="2" Style="height: 120px; border-radius: 12px;" @onclick="@(() => Navigation.NavigateTo("/admin/agenda"))">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                        <MudText Typo="Typo.body2" Align="Align.Center" Class="fw-bold">Agenda</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6">
                    <MudPaper Class="pa-4 d-flex flex-column align-center justify-center cursor-pointer" Elevation="2" Style="height: 120px; border-radius: 12px;" @onclick="@(() => Navigation.NavigateTo("/admin/pedidos"))">
                        <MudIcon Icon="@Icons.Material.Filled.LocalMall" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                        <MudText Typo="Typo.body2" Align="Align.Center" Class="fw-bold">Pedidos</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6">
                    <MudPaper Class="pa-4 d-flex flex-column align-center justify-center cursor-pointer" Elevation="2" Style="height: 120px; border-radius: 12px;" @onclick="@(() => Navigation.NavigateTo("/productos"))">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                        <MudText Typo="Typo.body2" Align="Align.Center" Class="fw-bold">Productos</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6">
                    <MudPaper Class="pa-4 d-flex flex-column align-center justify-center cursor-pointer" Elevation="2" Style="height: 120px; border-radius: 12px;" @onclick="@(() => Navigation.NavigateTo("/tratamientos"))">
                        <MudIcon Icon="@Icons.Material.Filled.Spa" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                        <MudText Typo="Typo.body2" Align="Align.Center" Class="fw-bold">Servicios</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </Authorized>
    </AuthorizeView>

    @* --- VISTA PARA CLIENTES Y VISITANTES --- *@
    <AuthorizeView Roles="Admin">
        <NotAuthorized>
            <MudText Typo="Typo.h5" Class="fw-bold mb-2" Style="color: var(--mud-palette-primary);">Bienvenido a MOER</MudText>

            <AuthorizeView Roles="Cliente" Context="ClienteContext">
                <Authorized>
                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4" Style="border-color: var(--mud-palette-secondary);">
                        Estás conectado como <b>Cliente</b>. Ya podés agendar turnos y armar pedidos.
                    </MudAlert>
                </Authorized>
            </AuthorizeView>

            <MudText Typo="Typo.body2" Class="mb-6 text-muted">
                Tu espacio dedicado al bienestar, relax y belleza. Descubrí nuestros tratamientos diseñados exclusivamente para vos.
            </MudText>

            @* CARRUSEL *@
            <MudCarousel Class="mud-width-full rounded-lg mb-6" Style="height:200px;" ShowArrows="true" ShowBullets="true" AutoCycle="true" TData="object">
                <MudCarouselItem Transition="Transition.Slide">
                    <div class="d-flex justify-center align-center h-100" style="background-color: #F5E6E0;">
                        <MudText Typo="Typo.h6" Style="color: var(--mud-palette-primary);">Limpieza Facial</MudText>
                    </div>
                </MudCarouselItem>
                <MudCarouselItem Transition="Transition.Slide">
                    <div class="d-flex justify-center align-center h-100" style="background-color: var(--mud-palette-secondary);">
                        <MudText Typo="Typo.h6" Style="color: #FFFFFF;">Masajes Relajantes</MudText>
                    </div>
                </MudCarouselItem>
            </MudCarousel>

            @* ACCESO A SERVICIOS *@
            <MudPaper Class="pa-4 mb-6" Elevation="0" Style="background-color: rgba(178, 201, 171, 0.15); border-radius: 12px; border: 1px solid var(--mud-palette-secondary);">
                <div class="d-flex align-center justify-space-between">
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="fw-bold">Catálogo de Servicios</MudText>
                        <MudText Typo="Typo.caption">Explorá los tratamientos.</MudText>
                    </div>
                    <MudButton Href="/tratamientos" Variant="Variant.Filled" DisableElevation="true" Style="background-color: var(--mud-palette-secondary); color: white; border-radius: 8px;">
                        Ver Todo
                    </MudButton>
                </div>
            </MudPaper>

            @* SOBRE NOSOTROS *@
            <MudCard Elevation="2" Style="border-radius: 15px; overflow: hidden;" Class="mb-4">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="fw-bold mb-2">Sobre Nosotros</MudText>
                    <MudText Typo="Typo.body2">
                        En MOER Estética nos enfocamos en brindar una experiencia completa para desconectar de la rutina. Contamos con profesionales capacitados y productos de primera línea.
                    </MudText>
                </MudCardContent>
            </MudCard>
        </NotAuthorized>
    </AuthorizeView>

</MudContainer>