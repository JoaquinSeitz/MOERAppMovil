@page "/mis-turnos"
@using MOERAppMovil.DTOs
@using MOERAppMovil.Services
@inject TurnoService TurnoService
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "Cliente")]

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="pt-4 pb-16">
    <div class="d-flex align-center justify-space-between mb-4">
        <MudText Typo="Typo.h5" Style="color: var(--mud-palette-primary); font-family: 'Georgia', serif;">Mis Turnos</MudText>
        <MudButton Variant="Variant.Filled" Size="Size.Small" Href="/agendar-turno" Style="background-color: var(--mud-palette-secondary); color: white; border-radius: 8px;">
            + Nuevo
        </MudButton>
    </div>

    @if (turnos == null)
    {
        <div class="d-flex justify-center my-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (!turnos.Any())
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Style="border-color: var(--mud-palette-primary);">
            No tienes turnos registrados actualmente.
        </MudAlert>
    }
    else
    {
        <MudStack Spacing="3">
            @foreach (var turno in turnos.OrderByDescending(t => t.Fecha))
            {
                <MudCard Elevation="2" Style="border-radius: 12px; border-left: 5px solid var(--mud-palette-secondary);">
                    <MudCardContent Class="pa-3">
                        <div class="d-flex justify-space-between align-start mb-1">
                            <MudText Typo="Typo.subtitle1" Class="fw-bold">@turno.Servicio</MudText>
                            <MudChip T="string" Color="@GetEstadoColor(turno.Estado)" Size="Size.Small" Class="mt-0">@turno.Estado</MudChip>
                        </div>

                        <div class="d-flex align-center mb-1">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" Class="mr-1 text-muted" />
                            <MudText Typo="Typo.body2" Class="text-muted mr-3">@turno.Fecha.ToString("dd/MM/yyyy")</MudText>

                            <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Class="mr-1 text-muted" />
                            <MudText Typo="Typo.body2" Class="text-muted">@turno.HoraInicio.ToString(@"hh\:mm")</MudText>
                        </div>

                        <div class="d-flex justify-space-between align-center mt-2">
                            <MudText Typo="Typo.body2" Class="fw-bold" Style="color: var(--mud-palette-primary);">
                                @turno.Precio.ToString("C")
                            </MudText>

                            @if (turno.Estado == "Pendiente")
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => CancelarTurno(turno.IdTurno))">
                                    Cancelar
                                </MudButton>
                            }
                        </div>
                    </MudCardContent>
                </MudCard>
            }
        </MudStack>
    }
</MudContainer>

@code {
    private List<TurnoResponseDTO>? turnos;

    protected override async Task OnInitializedAsync()
    {
        await CargarTurnos();
    }

    private async Task CargarTurnos()
    {
        turnos = await TurnoService.GetMisTurnos();
    }

    private async Task CancelarTurno(int idTurno)
    {
        var response = await TurnoService.CancelarTurno(idTurno);
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("Turno cancelado exitosamente", Severity.Success);
            await CargarTurnos();
        }
        else
        {
            Snackbar.Add("Hubo un problema al cancelar el turno", Severity.Error);
        }
    }

    private Color GetEstadoColor(string estado) => estado switch
    {
        "Pendiente" => Color.Warning,
        "Completado" => Color.Success,
        "Cancelado" => Color.Error,
        _ => Color.Default
    };
}